using Gtk 4.0;
using Adw 1;

/* Phase 4 Console structure (live UI in Rust `window.rs` / `combat_ui.rs` /
 * `presenter_window.rs`). Blueprint documents chrome for a later template-load
 * migration. */
template $InitiativeTrackerWindow : Adw.ApplicationWindow {
  title: _("Initiative Tracker: Console");
  default-width: 540;
  default-height: 720;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add campaign");
        styles [
          "flat",
        ]
      }

      title-widget: DropDown {
        hexpand: true;
      };

      [end]
      Button {
        tooltip-text: _("Settings");
        styles [
          "flat",
        ]

        child: Adw.ButtonContent {
          icon-name: "emblem-system-symbolic";
          label: _("Settings");
        };
      }
    }

    ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;

      Adw.Clamp {
        maximum-size: 560;
        tightening-threshold: 400;

        Box {
          orientation: vertical;
          spacing: 12;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          Expander {
            label: _("Presenter & Media");
            expanded: true;

            Box {
              orientation: vertical;
              spacing: 8;
              /* Open Presenter / Fullscreen / Close; images in Phase 5 */
            }
          }

          Expander {
            label: _("Add Combatant");
          }

          Box {
            orientation: horizontal;
            spacing: 6;
            homogeneous: true;
            /* Visibility toggles: Initiative / Enemy HP / Player HP */
          }

          Box {
            orientation: vertical;
            spacing: 6;
            /* Combatant list (GtkListBox boxed-list) */
          }
        }
      }
    }

    [bottom]
    ActionBar {
      /* Previous / Next Turn / Start / End / Long Rest / Clear Monsters */
    }
  }
}
