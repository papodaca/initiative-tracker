{
  "id": "im.apodaca.InitiativeTracker",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "initiative-tracker-gtk",
  "appstream-compose": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": [
      "--share=network"
    ],
    "env": {
      "CARGO_HOME": "/run/build/initiative-tracker-gtk/cargo-home",
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "initiative_tracker_gtk=debug"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "totem-pl-parser",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/totem-pl-parser/3.26/totem-pl-parser-3.26.6.tar.xz",
          "sha256": "c0df0f68d5cf9d7da43c81c7f13f11158358368f98c22d47722f3bd04bd3ac1c"
        }
      ]
    },
    {
      "name": "totem-video-thumbnailer",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/totem-video-thumbnailer.git",
          "commit": "6cb399918571a97591ff5a4a5a41d8e46b11027a",
          "disable-submodules": false
        }
      ]
    },
    {
      "name": "initiative-tracker-gtk",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked",
        "install -Dm755 target/release/initiative-tracker-gtk /app/bin/initiative-tracker-gtk",
        "bash packaging/install-data.sh /app"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
