# Local Arch package. From this directory:
#   makepkg -si
# Builds the git checkout two directories up (repo root).

pkgname=initiative-tracker-gtk
pkgver=0.1.0
pkgrel=1
pkgdesc='GTK4/libadwaita initiative tracker for tabletop RPG campaigns'
url='https://github.com/papodaca/initiative-tracker'
license=('MIT')
arch=('x86_64' 'aarch64')

_repo_root=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../.." && pwd)

source=()
sha256sums=()

options=('!lto' '!debug')

makedepends=(
  cargo
  pkgconf
  git
  gcc
  desktop-file-utils
  appstream
)

depends=(
  gtk4
  libadwaita
  glib2
  gdk-pixbuf2
  gcc-libs
  hicolor-icon-theme
)

pkgver() {
  cd "${_repo_root}"
  local tag
  tag=$(git describe --tags --exact-match HEAD 2>/dev/null || true)
  if [[ ${tag} =~ ^v([0-9][^[:space:]]*)$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '0.1.0.r%s.%s' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "${_repo_root}"
  export CARGO_HOME="${_repo_root}/build-pkg/cargo-home"
  export CARGO_TARGET_DIR="${_repo_root}/build-pkg/cargo-target"
  cargo build --release --locked
}

check() {
  cd "${_repo_root}"
  export CARGO_HOME="${_repo_root}/build-pkg/cargo-home"
  export CARGO_TARGET_DIR="${_repo_root}/build-pkg/cargo-target"
  cargo test --release --locked
  desktop-file-validate data/im.apodaca.InitiativeTracker.desktop
  appstreamcli validate --no-net --explain \
    data/im.apodaca.InitiativeTracker.metainfo.xml
}

package() {
  cd "${_repo_root}"
  install -Dm755 build-pkg/cargo-target/release/initiative-tracker-gtk \
    "${pkgdir}/usr/bin/initiative-tracker-gtk"
  bash "${_repo_root}/packaging/install-data.sh" /usr "${pkgdir}"
}
